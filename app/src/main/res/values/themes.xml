<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch theme paints the warm canvas so the first frame matches the
         SwiftUI background instead of flashing white. Compose supplies all
         other styling through CentraliaTheme. -->
    <style name="Theme.Centralia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/warm_canvas</item>
        <item name="android:statusBarColor">@color/warm_canvas</item>
        <item name="android:navigationBarColor">@color/warm_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
